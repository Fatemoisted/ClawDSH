{
  "id": "clawdsh-bridge",
  "name": "ClawDSH Bridge",
  "description": "Routes admitted OpenClaw channel turns to a local ClawDSH Agent.",
  "version": "1.0.0",
  "providers": ["clawdsh"],
  "syntheticAuthRefs": ["clawdsh"],
  "nonSecretAuthMarkers": ["clawdsh-local"],
  "activation": {
    "onStartup": false,
    "onAgentHarnesses": ["clawdsh"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "controlTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "default": 10000
      },
      "routeStateMaxEntries": {
        "type": "integer",
        "minimum": 1,
        "default": 100000
      },
      "deliveryStateMaxEntries": {
        "type": "integer",
        "minimum": 1,
        "default": 100000
      }
    }
  }
}
